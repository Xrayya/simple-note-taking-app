{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "outDir": "./dist",
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler"
  },
  "exclude": [
    "node_modules"
  ]
}
